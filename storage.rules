rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{kind}/{file} {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && kind in ['properties', 'payments', 'paymentMethods'];
      }
      allow read, delete: if owner();
      allow create: if owner() && resource == null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
  }
}
